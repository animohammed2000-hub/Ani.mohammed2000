# Copy to .env (or .env.local for machine-specific overrides) and fill in.
# Vite only exposes variables prefixed with VITE_ to the client bundle, so
# these must be public values. Never commit a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional alias used by some existing setups (same value as above).
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional; defaults to "aani-media".
VITE_SUPABASE_STORAGE_BUCKET=
